import turtle as t
import random

score = 0           # 점수를 저장하는 변수
playing = False     # 현재 게임이 플레이 중인지 확인하는 변수
firing = False      # 미사일이 발사 중인지 확인하는 변수

# 미사일 (노란색 삼각형)
tm = t.Turtle()
tm.shape("triangle")
tm.color("yellow")
tm.speed(0)
tm.up()
tm.setheading(90)
tm.goto(0, 400)     # 발사 전에는 화면 위쪽 바깥에 대기

# 적 우주선 1 (빨간색 거북이)
te1 = t.Turtle()
te1.shape("turtle")
te1.color("red")
te1.speed(0)
te1.up()
te1.setheading(270)
te1.goto(-150, 280)

# 적 우주선 2 (주황색 거북이)
te2 = t.Turtle()
te2.shape("turtle")
te2.color("Orange")
te2.speed(0)
te2.up()
te2.setheading(270)
te2.goto(150, 360)

# 점수 표시용 거북이
ts = t.Turtle()
ts.color("White")
ts.speed(0)
ts.up()
ts.goto(-290, 290)


def move_left():            # 왼쪽으로 이동
    if playing:
        if t.xcor() > -300:
            t.goto(t.xcor() - 25, -250)


def move_right():           # 오른쪽으로 이동
    if playing:
        if t.xcor() < 300:
            t.goto(t.xcor() + 25, -250)


def space_key():            # SpaceBar: 대기 중이면 시작, 게임 중이면 발사
    global playing
    global firing
    if playing == False:
        start()
    else:
        if firing == False:
            firing = True
            tm.goto(t.pos())


def show_score():           # 왼쪽 위에 현재 점수 출력
    ts.clear()
    ts.goto(-290, 290)
    ts.write("Score : " + str(score), False, "left", ("", 15))


def start():                # 게임을 시작하는 함수
    global playing
    global firing
    global score
    playing = True
    firing = False
    score = 0
    t.clear()
    t.goto(0, -250)
    t.setheading(90)
    tm.goto(0, 400)
    te1.goto(random.randint(-280, 280), 300)
    te2.goto(random.randint(-280, 280), 380)
    show_score()
    play()


def play():                 # 게임을 실제로 플레이하는 함수
    global score
    global playing
    global firing

    # 미사일이 발사된 상태면 위로 이동
    if firing:
        tm.forward(25)
        if tm.ycor() > 330:         # 화면 위로 벗어나면 발사 종료
            firing = False
            tm.goto(0, 400)

    # 적 우주선 1 이동 (점수에 따라 속도 증가)
    speed1 = score + 3
    if speed1 > 11:
        speed1 = 11
    te1.forward(speed1)

    # 적 우주선 2 이동 (점수에 따라 속도 증가)
    speed2 = score + 2
    if speed2 > 9:
        speed2 = 9
    te2.forward(speed2)

    # 미사일이 적 1을 맞혔을 때
    if firing and tm.distance(te1) < 25:
        score = score + 1
        show_score()
        firing = False
        tm.goto(0, 400)
        te1.goto(random.randint(-280, 280), 300)

    # 미사일이 적 2를 맞혔을 때
    if firing and tm.distance(te2) < 25:
        score = score + 1
        show_score()
        firing = False
        tm.goto(0, 400)
        te2.goto(random.randint(-280, 280), 300)

    # 적이 바닥에 닿거나 주인공과 부딪히면 게임 종료
    if te1.ycor() < -250 or te2.ycor() < -250 or t.distance(te1) < 25 or t.distance(te2) < 25:
        text = "Score : " + str(score)
        ts.clear()
        message("Game Over", text)
        playing = False
        firing = False
        tm.goto(0, 400)
        score = 0

    if playing:                     # 게임 플레이 중이면 0.05초 후 play 함수 실행
        t.ontimer(play, 50)


def message(m1, m2):        # 화면에 메시지를 표시하는 함수
    t.clear()
    t.goto(0, 100)
    t.write(m1, False, "center", ("", 20))
    t.goto(0, -100)
    t.write(m2, False, "center", ("", 15))
    t.goto(0, -250)


# 기본 화면 및 주인공 우주선 설정
t.title("Space Shooter")
t.setup(700, 700)
t.bgcolor("black")
t.shape("turtle")
t.speed(0)
t.up()
t.color("Blue")
t.setheading(90)

# 키보드 조작키
t.onkeypress(move_left, "Left")
t.onkeypress(move_right, "Right")
t.onkeypress(space_key, "space")
t.listen()

message("Space Shooter", "[Space]")
t.mainloop()
